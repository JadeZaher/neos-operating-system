# Required
DATABASE_URL=sqlite+aiosqlite:///neos.db

# AI Provider (OpenRouter free tier recommended)
# Get a free key at https://openrouter.ai/keys
AI_API_KEY=sk-or-v1-your-openrouter-key-here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/quasar-alpha
AI_PROVIDER=openrouter

# Optional (Anthropic legacy)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional (LiteLLM proxy for local LLMs)
# AI_BASE_URL=http://localhost:8001
# AI_MODEL=ollama/llama3.1:8b

# Optional (defaults shown)
NEOS_CORE_PATH=../neos-core
LOG_LEVEL=info
CORS_ORIGINS=*
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Optional private Railway bucket for /api/v1/media/* redirects
# Keep these values server-side; do not expose them to the frontend build.
AWS_ENDPOINT_URL=...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET_NAME=neos-rich-media
AWS_DEFAULT_REGION=...
AWS_S3_URL_STYLE=virtual
